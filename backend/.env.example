# ============================================
# RexMatch 后端环境变量配置
# 复制为 .env 并填入真实值
# ============================================

# 基础配置
DEBUG=false
SECRET_KEY=your-random-secret-key-here

# CockroachDB 数据库（CockroachDB Cloud 免费版 10GB）
# 格式: cockroachdb+asyncpg://user:password@host:26257/defaultdb
# 也支持 Neon PostgreSQL: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=cockroachdb+asyncpg://user:password@xxx.cockroachlabs.cloud:26257/defaultdb

# Redis（Upstash 免费版）
# 格式: rediss://default:password@host:port
REDIS_URL=rediss://default:xxx@us1-xxx.upstash.io:6379

# Supabase Storage（S3 兼容，1GB 免费）
S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET_NAME=rexmatch
S3_PUBLIC_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/rexmatch
S3_REGION=us-west-1

# 微信小程序（可选，不填则走测试登录）
WX_APP_ID=
WX_APP_SECRET=

# CORS 允许的前端域名（逗号分隔）
ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://your-domain.com

# 每日配置
DAILY_RECOMMEND_LIMIT=20
DAILY_LIKE_LIMIT=10
